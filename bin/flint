#!/usr/bin/env bash
# flint launcher — Forth source linter.
#
# Conventions (shared with bin/fmix and any future bin/fcov):
#   - $<TOOL>_HOME  ─ where the tool's source tree lives. Defaults to
#                     $HOME/<tool>; override per-shell if you keep tools
#                     elsewhere.
#   - $<TOOL>_CMD   ─ subcommand (lint, version, help).
#   - $<TOOL>_ARG   ─ single positional argument string, if any.
#   - reset_tty     ─ only fires when stdout actually is a tty.
#
# Recommended ~/.bashrc snippet — one separate line per tool so each one
# can be installed / removed independently of the others:
#
#   export PATH="$HOME/flint/bin:$PATH"
#   # export PATH="$HOME/fmix/bin:$PATH"   # if/when you also use fmix
#   # export PATH="$HOME/fcov/bin:$PATH"   # if/when you also use fcov
#
: "${FLINT_HOME:=$HOME/flint}"
GFORTH="${GFORTH:-gforth}"

reset_tty() {
    # Only touch a tty if we actually have one — otherwise `\033[?2004l`
    # lands in the captured output as the visible string `[?2004l`.
    local tty_path
    tty_path=$(tty 2>/dev/null || true)
    case "$tty_path" in
        ""|"not a tty") return ;;
    esac
    [ -r "$tty_path" ] && [ -w "$tty_path" ] || return

    stty sane < "$tty_path" 2>/dev/null || true
    printf '\033[?2004l' > "$tty_path" 2>/dev/null || true

    local _ch
    while IFS= read -r -s -t 0.02 -n 1 _ch < "$tty_path"; do
        :
    done
}

reset_tty

FLINT_STRICT=0
FLINT_PROJECT_ONLY=0

if [ $# -eq 0 ]; then
    FLINT_CMD=lint
    FLINT_ARG=.
else
    FLINT_CMD=$1
    shift
    if [ "$FLINT_CMD" = "lint" ]; then
        FLINT_ARG=.
        while [ $# -gt 0 ]; do
            case "$1" in
                --strict)        FLINT_STRICT=1; shift ;;
                --project-only)  FLINT_PROJECT_ONLY=1; shift ;;
                --)              shift; break ;;
                --*)
                    echo "[ERROR] Unknown lint flag: $1" >&2
                    exit 1
                    ;;
                *)
                    FLINT_ARG=$1
                    shift
                    while [ $# -gt 0 ]; do
                        case "$1" in
                            --strict)        FLINT_STRICT=1; shift ;;
                            --project-only)  FLINT_PROJECT_ONLY=1; shift ;;
                            --)              shift; break ;;
                            --*)
                                echo "[ERROR] Unknown lint flag: $1" >&2
                                exit 1
                                ;;
                            *)
                                echo "[ERROR] Unexpected argument after path: $1" >&2
                                exit 1
                                ;;
                        esac
                    done
                    break
                    ;;
            esac
        done
    else
        FLINT_ARG=${1:-.}
    fi
fi
export FLINT_CMD FLINT_ARG FLINT_HOME FLINT_STRICT FLINT_PROJECT_ONLY

set +e
# Add $FLINT_HOME to gforth's fpath (search path for `require`) so module
# imports resolve no matter which directory the user invoked flint from.
"$GFORTH" \
    -e "s\" $FLINT_HOME\" fpath also-path" \
    "$FLINT_HOME/flint.4th"
status=$?
set -e

reset_tty
exit "$status"
